@page "/processos"
@rendermode InteractiveServer

@using AppWebNaiara.Model
@using AppWebNaiara.DAO

@inject ProcessoDAO ProcessoDAO

<PageTitle>Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            Consulta de Processos
        </h2>

        <p class="text-muted mb-0">
            Processos cadastrados no sistema
        </p>
    </div>

    <div>
        <a href="/processos/cadastro"
               class="btn btn-primary">

            + Novo Processo

        </a>
    </div>

</div>

<div class="custom-table-card">

    <div class="table-responsive">

        <table class="table align-middle">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>Número</th>
                    <th>Data</th>
                    <th>Interessado</th>
                    <th>Assunto</th>
                    <th>Situação</th>
                </tr>
            </thead>

            <tbody>

                @if (processos.Count == 0)
                {
                    <tr>
                        <td colspan="6"
                            class="text-center py-4">

                            Nenhum processo cadastrado.

                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var processo in processos)
                    {
                        <tr>

                            <td>
                                @processo.Id
                            </td>

                            <td>
                                @processo.Numero
                            </td>

                            <td>
                                @(processo.Data?.ToString("dd/MM/yyyy") ?? "-")
                            </td>

                            <td>
                                @processo.Interessado
                            </td>

                            <td>
                                @processo.Assunto
                            </td>

                            <td>
                                @processo.Situacao
                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>

@code {

    private List<Processo> processos = new();

    protected override void OnInitialized()
    {
        processos = ProcessoDAO.Listar();
    }

}